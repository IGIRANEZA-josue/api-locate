# ============================================================================
# API LOCATE - BACKEND ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to backend/.env and configure your local credentials.
# ============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=api_locate
DB_CONNECTION_LIMIT=10

# Authentication & Security
JWT_SECRET=replace-with-a-minimum-32-char-random-secret-key
JWT_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# Payment Provider Integration (Stripe Checkout + Signed Webhooks)
# Leave STRIPE_SECRET_KEY empty until you connect your real Stripe account.
# Never commit real secret keys to Git.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=replace-with-signed-webhook-hmac-secret
